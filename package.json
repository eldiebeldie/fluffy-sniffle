{
  "name": "fluffy-sniffle",
  "version": "1.0.0",
  "description": "GitHub repository health analyzer: checks stale branches, open PRs, and generates summaries across multiple repos.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js --open",
    "dev": "node --watch --watch-path=src --watch-path=config.json src/server.js --open --dev",
    "dev:no-open": "node --watch --watch-path=src --watch-path=config.json src/server.js --dev",
    "server": "node src/server.js",
    "cli": "node src/index.js",
    "report:html": "node src/index.js --html",
    "report:markdown": "node src/index.js --markdown",
    "docker:build": "docker build -t fluffy-sniffle .",
    "docker:run": "docker run -d -p 3000:3000 --env-file .env -v ${PWD}/reports:/app/reports fluffy-sniffle"
  },
  "keywords": [
    "github",
    "pull-requests",
    "stale-branches",
    "repository-health",
    "octokit"
  ],
  "author": "EldieBeldie <eldargr@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "dotenv": "^16.4.7",
    "express": "^5.3.0"
  }
}
