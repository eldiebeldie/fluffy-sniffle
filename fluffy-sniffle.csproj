<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>fluffy-sniffle</AssemblyName>
    <RootNamespace>FluffySniffle</RootNamespace>
    <Authors>EldieBeldie &lt;eldargr@gmail.com&gt;</Authors>
    <Company>EldieBeldie</Company>
    <Product>fluffy-sniffle</Product>
    <Description>GitHub repository health analyzer: checks stale branches, open PRs, and generates summaries across multiple repos.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*" />
  </ItemGroup>
</Project>
