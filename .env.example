# GitHub Personal Access Token (Classic with repo scope, or Fine-grained with PR/Contents Read scope)
GITHUB_TOKEN=<TOKEN>

# Push & Write Protection Flag (default: false)
# Blocks git push (via .githooks/pre-push) and any outbound write/mutation GitHub API calls unless intentionally set to true by the user
ALLOW_GIT_PUSH=false

# Server Network & Security Configuration
# Bind address (default: 127.0.0.1 for local-only access; set to 0.0.0.0 only inside containers or behind a reverse proxy)
HOST=127.0.0.1
PORT=3000

# API & Dashboard Authentication
# Required API key to access /api/* endpoints (e.g. /api/data, /api/scan, /api/repos) via X-API-Key or Authorization: Bearer <API_KEY>
DASHBOARD_API_KEY=<API_KEY>
# Optional: Require authentication on the root / dashboard route as well (default: false)
DASHBOARD_REQUIRE_AUTH=false
# Optional: Lock repository list modifications via web API (default: false)
DASHBOARD_READONLY=false

# Disk Persistence Controls (No-Disk Mode by Default)
# Set to true only if you explicitly want scan cache or HTML/Markdown reports written to reports/ on disk
ENABLE_DISK_CACHE=false
ENABLE_DISK_REPORTS=false
ENABLE_DISK_PERSISTENCE=false
ENABLE_EMBEDDED_REPORT_DATA=false

# TLS & Certificate Configuration
# Optional: Path to custom CA certificate bundle (e.g., enterprise root or corporate proxy CA)
# GITHUB_CA_CERT_PATH=<CERT_PATH>

# Optional: Insecure TLS mode for local troubleshooting and diagnostics only (default: false)
# WARNING: Setting this to true disables certificate verification. Never enable in production.
GITHUB_ALLOW_INSECURE_TLS=false
