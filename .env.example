# GitHub Personal Access Token (Classic with repo scope, or Fine-grained with PR/Contents Read scope)
GITHUB_TOKEN=your_github_pat_token_here

# TLS & Certificate Configuration
# Optional: Path to custom CA certificate bundle (e.g., enterprise root or corporate proxy CA)
# GITHUB_CA_CERT_PATH=C:/path/to/enterprise-ca-bundle.pem

# Optional: Insecure TLS mode for local troubleshooting and diagnostics only (default: false)
# WARNING: Setting this to true disables certificate verification. Never enable in production.
GITHUB_ALLOW_INSECURE_TLS=false
